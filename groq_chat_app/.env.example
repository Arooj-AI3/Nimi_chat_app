# Copy this file to ".env" and fill in your keys.
# NEVER commit ".env" (it is in .gitignore). If a key was ever pasted in a chat,
# email or commit, revoke it and create a new one.

# --- Groq: chat, PDF/text Q&A and image understanding ------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

GROQ_BASE_URL=https://api.groq.com/openai/v1

# Text model. (llama-3.3-70b-versatile and llama-3.1-8b-instant were shut down
# by Groq on 2026-08-16 - do not use them.) Alternatives: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically once if GROQ_MODEL is rate-limited or unavailable.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Groq's only vision model (max 3 images per request, ~2048 tokens each).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Max tokens per reply. Lower it if you hit tokens-per-minute limits.
GROQ_MAX_OUTPUT_TOKENS=900

# --- OpenRouter: image generation --------------------------------------------
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_key_here

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Text -> image model. NOTE: "...-design-layer2" does not exist. The real slugs are:
#   inclusionai/ming-image-0.1-design        (text -> image)   <- use this
#   inclusionai/ming-image-0.1-design-layer  (image -> RGBA layers, needs 1 input image)
OPENROUTER_IMAGE_MODEL=inclusionai/ming-image-0.1-design
# Optional image -> image model, used only when you attach an image AND ask for a
# new image. Leave empty to have the vision model describe the image and generate
# from that description instead.
OPENROUTER_IMAGE_EDIT_MODEL=

# --- Request-size limits (protect against per-minute token limits) -----------
# Max characters of text taken from EACH attached document.
MAX_ATTACHMENT_CHARS=20000
# Max characters of conversation sent per request (oldest messages dropped first).
MAX_CONTEXT_CHARS=40000

# --- App ----------------------------------------------------------------------
# Default UI language: en, ur, es, fr        Default theme: dark, light
APP_LANGUAGE=en
APP_THEME=dark
